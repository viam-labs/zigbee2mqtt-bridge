{
    "module_id": "viam:zigbee2mqtt-bridge",
    "visibility": "public",
    "url": "https://github.com/viam-labs/zigbee2mqtt-bridge",
    "description": "Bridges zigbee2mqtt devices into Viam: button actions into an events sensor, on/off devices (smart plugs, relays) as switches, and tunable-white bulbs as generics with scheduled in-lamp ramps.",
    "models": [
        {
            "api": "rdk:component:sensor",
            "model": "viam:zigbee2mqtt:bridge",
            "markdown_link": "README.md#bridge"
        },
        {
            "api": "rdk:component:switch",
            "model": "viam:zigbee2mqtt:switch",
            "markdown_link": "README.md#switch"
        },
        {
            "api": "rdk:component:generic",
            "model": "viam:zigbee2mqtt:light",
            "markdown_link": "README.md#light"
        }
    ],
    "entrypoint": "run.sh"
}
